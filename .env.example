# Required: Your Society AI API key (get it at https://societyai.com)
SOCIETY_AI_AUTH_TOKEN=sai_your_api_key_here

# Optional: Agent name. Defaults to claude-code-<user>-<hostname> when set
# by setup.sh. Override only if you know what you're doing — two bridges
# sharing the same AGENT_NAME on the same account will fight for the slot.
# AGENT_NAME=claude-code

# Optional: Default company UUID (if you belong to a company)
# COMPANY_ID=

# Optional: Working directory for Claude Code (default: current directory).
# Standard mode only — secured mode does NOT mount WORK_DIR into the sandbox.
# When run as a LaunchAgent, the default cwd is the integration's own repo
# (~/Coding/claude-code-agent), which is why the agent says it can "only see
# this folder" out of the box. Point this at the project you want it rooted in.
# WORK_DIR=/path/to/your/project

# Optional: Comma-separated additional directories the spawned Claude Code is
# allowed to read AND write. Claude Code's sandbox is per-cwd by default;
# every path listed here is added via `claude -p --add-dir`. Use absolute
# paths. Missing directories are warned and skipped. SECURITY: anything in
# these directories is fully readable AND modifiable by the agent — do NOT
# include ~/.ssh, ~/.aws, ~/Library/Keychains, or any directory that holds
# credentials. Listing ~/Coding (or a similar code root) is the usual case.
# EXTRA_DIRS=/Users/me/Coding,/Users/me/Desktop/scratch

# Optional: Max parallel tasks (default: 3)
# MAX_CONCURRENT_TASKS=3

# Optional: Truncation cap for task result text sent over WS (default: 16000)
# MAX_RESULT_CHARS=16000

# Optional: API URL (default: https://api.societyai.com)
# AGENT_ROUTER_API_URL=https://api.societyai.com

# Optional: Execution mode — "standard" (host) or "secured" (OpenShell sandbox)
# EXECUTION_MODE=standard
# SANDBOX_NAME=society-ai-agent
# SANDBOX_BASE_IMAGE=claude
# SANDBOX_TIMEOUT=600

# Optional: IPC socket path used between the bridge daemon and the
# in-Claude-Code MCP server (powers search_agents + delegate_task).
# Defaults to ~/.cache/society-ai/bridge.sock.
# SOCIETY_AI_BRIDGE_SOCKET=/Users/me/.cache/society-ai/bridge.sock

# Optional: Opt in to high-power agent lifecycle tools
# (deploy/update/restart/delete_agent). Off by default — a misbehaving LLM
# accidentally spinning up or deleting agents is hard to undo.
# ENABLE_AGENT_LIFECYCLE=false

# Optional: How much intermediate progress the bridge surfaces to the
# Society AI chat UI while Claude Code is working. Mirrors OpenClaw's
# workflow_step pattern: each tool call shows up as a callout the user
# can watch in real time.
#   quiet   — tool calls + results only (no thinking markers, no text deltas)
#   normal  — tool calls + results + "Thinking: <first sentence>" markers
#   verbose — everything in normal + assistant text streamed progressively
# STATUS_VERBOSITY=normal
